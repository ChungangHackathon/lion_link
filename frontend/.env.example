# 이 파일을 복사해 .env.local로 만들고 값을 채우세요. (.env.local은 커밋되지 않아요)
#   cp .env.example .env.local
#
# 백엔드 서버 주소 (끝에 / 없이). /api/v1 은 자동으로 붙어요.
#   - 로컬 백엔드: http://localhost:8080
#   - 비워 두면 백엔드 없이 mock 데이터(프로토타입 모드)로 동작해요.
NEXT_PUBLIC_API_URL=http://localhost:8080

# 채팅 WebSocket 주소 (선택). 비우면 NEXT_PUBLIC_API_URL에서 ws://…/ws 로 만들어요 (로컬).
#   운영은 프론트가 API를 프록시하는데 프록시는 WebSocket을 넘기지 못해서, 백엔드 주소를 따로 줘요.
#   예: wss://lionlink.n-e.kr/ws  (끝에 /ws 포함)
# NEXT_PUBLIC_WS_URL=

# 프록시 대상 백엔드 주소 (서버 전용, NEXT_PUBLIC 아님. 끝에 / 없이). 빌드할 때 읽혀요.
#   /api, /oauth2, /login/oauth2 요청을 이 주소로 넘겨요 (Safari 로그인용, next.config.ts rewrites).
#   운영(Vercel): NEXT_PUBLIC_API_URL은 프론트 자기 주소(https://lion-link.vercel.app)로 두면 모든 요청이 프록시를 타요.
#   로컬은 NEXT_PUBLIC_API_URL=http://localhost:8080으로 직접 호출하니 이 값은 안 써도 돼요. 기본값 https://lionlink.n-e.kr
# BACKEND_ORIGIN=https://lionlink.n-e.kr
